{% extends 'base.html.twig' %}

{% block title %}Product Page{% endblock %}
{% block body %}
<div class="grid grid-cols-4 gap-6">
    <div class="bg-white rounded shadow p-6">
        <div class="text-gray-500">
            Products
        </div>

        <div class="text-4xl font-bold mt-2">
            {{ totalProducts }}
        </div>
    </div>

    <div class="bg-white rounded shadow p-6">
        <div class="text-gray-500">
            Expiring Soon
        </div>

        <div class="text-4xl font-bold mt-2">
            {{ expiringProducts }}
        </div>
    </div>
</div>
{% endblock %}