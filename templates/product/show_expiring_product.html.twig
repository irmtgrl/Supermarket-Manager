{% extends 'base.html.twig' %}

{% block title %}Product Page - Single{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto p-6 space-y-12">
    
    {# --- EXPIRING PRODUCTS SECTION --- #}
    <div>
        <h1 class="text-3xl font-bold text-amber-500 mb-4">Expiring Products</h1>
        
        {% if expiringProducts is not empty %}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                {% for product in expiringProducts %}
                    <div class="bg-white p-4 rounded shadow border border-amber-200">
                        <h2 class="font-bold text-xl">{{ product.name }}</h2>
                        <p class="text-gray-600">{{ product.categoryName }}</p>
                        <p class="mt-2 font-semibold">${{ product.price }}</p>

                        {% if product.isLowStock %}
                            <div class="text-red-500 mt-2 font-medium">⚠️ Low Stock</div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-gray-500 italic">No expiring products found for the next 7 days.</p>
        {% endif %}
    </div>

    {# --- EXPIRED PRODUCTS SECTION --- #}
    <div>
        <h1 class="text-3xl font-bold text-red-700 mb-4">Expired Products</h1>
        
        {% if expiredProducts is not empty %}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                {% for product in expiredProducts %}
                    <div class="bg-white p-4 rounded shadow border border-red-200">
                        <h2 class="font-bold text-xl">{{ product.name }}</h2>
                        <p class="text-gray-600">{{ product.categoryName }}</p>
                        <p class="mt-2 font-semibold">${{ product.price }}</p>

                        {% if product.isLowStock %}
                            <div class="text-red-500 mt-2 font-medium">⚠️ Low Stock</div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-gray-500 italic">Great news! No expired products in stock.</p>
        {% endif %}
    </div>

</div>
{% endblock %}